          package com.example.infinitechest;

          import net.minecraft.world.Container;
          import net.minecraft.world.entity.player.Player;
          import net.minecraft.world.item.ItemStack;

          /** A 54-slot window onto one page of the infinite chest. */
          public class PagedView implements Container {
          	private final InfiniteChestBlockEntity chest;
          	private int page;

          	public PagedView(InfiniteChestBlockEntity chest) {
          		this.chest = chest;
          	}

          	public int getPage() {
          		return page;
          	}

          	public void setPage(int page) {
          		this.page = page;
          	}

          	public void purge() {
          		chest.purgeEmpty();
          	}

          	private long index(int slot) {
          		return (long) page * InfiniteChestBlockEntity.PAGE_SIZE + slot;
          	}

          	@Override
          	public int getContainerSize() {
          		return InfiniteChestBlockEntity.PAGE_SIZE;
          	}

          	@Override
          	public boolean isEmpty() {
          		for (int i = 0; i < getContainerSize(); i++) {
          			if (!getItem(i).isEmpty()) {
          				return false;
          			}
          		}
          		return true;
          	}

          	@Override
          	public ItemStack getItem(int slot) {
          		return chest.get(index(slot));
          	}

          	@Override
          	public ItemStack removeItem(int slot, int amount) {
          		ItemStack stack = chest.get(index(slot));
          		if (stack.isEmpty() || amount <= 0) {
          			return ItemStack.EMPTY;
          		}
          		ItemStack taken = stack.split(amount);
          		chest.put(index(slot), stack); // removes the entry if now empty
          		return taken;
          	}

          	@Override
          	public ItemStack removeItemNoUpdate(int slot) {
          		ItemStack stack = chest.get(index(slot));
          		chest.put(index(slot), ItemStack.EMPTY);
          		return stack;
          	}

          	@Override
          	public void setItem(int slot, ItemStack stack) {
          		chest.put(index(slot), stack);
          	}

          	@Override
          	public void setChanged() {
          		chest.setChanged();
          	}

          	@Override
          	public boolean stillValid(Player player) {
          		return Container.stillValidBlockEntity(chest, player);
          	}

          	@Override
          	public void clearContent() {
          		// Intentionally a no-op: never wipe an infinite chest by accident.
          	}
          }
