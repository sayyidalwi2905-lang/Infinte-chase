          package com.example.infinitechest;

          import java.util.List;
          import java.util.Set;

          import net.fabricmc.api.ModInitializer;
          import net.minecraft.core.Registry;
          import net.minecraft.core.component.DataComponentType;
          import net.minecraft.core.registries.BuiltInRegistries;
          import net.minecraft.core.registries.Registries;
          import net.minecraft.resources.Identifier;
          import net.minecraft.resources.ResourceKey;
          import net.minecraft.world.flag.FeatureFlagSet;
          import net.minecraft.world.inventory.MenuType;
          import net.minecraft.world.item.BlockItem;
          import net.minecraft.world.item.Item;
          import net.minecraft.world.level.block.Block;
          import net.minecraft.world.level.block.SoundType;
          import net.minecraft.world.level.block.entity.BlockEntityType;
          import net.minecraft.world.level.block.state.BlockBehaviour;

          public class InfiniteChestMod implements ModInitializer {
          	public static final String MOD_ID = "infinitechest";

          	public static DataComponentType<List<InfiniteChestBlockEntity.Entry>> CONTENTS;
          	public static Block INFINITE_CHEST;
          	public static BlockEntityType<InfiniteChestBlockEntity> INFINITE_CHEST_BE;
          	public static MenuType<InfiniteChestMenu> INFINITE_CHEST_MENU;

          	public static Identifier id(String path) {
          		return Identifier.fromNamespaceAndPath(MOD_ID, path);
          	}

          	@Override
          	public void onInitialize() {
          		// Item-side storage so the contents survive when the chest is broken.
          		CONTENTS = Registry.register(BuiltInRegistries.DATA_COMPONENT_TYPE, id("contents"),
          				DataComponentType.<List<InfiniteChestBlockEntity.Entry>>builder()
          						.persistent(InfiniteChestBlockEntity.Entry.LIST_CODEC)
          						.build());

          		ResourceKey<Block> blockKey = ResourceKey.create(Registries.BLOCK, id("infinite_chest"));
          		INFINITE_CHEST = Registry.register(BuiltInRegistries.BLOCK, blockKey,
          				new InfiniteChestBlock(BlockBehaviour.Properties.of()
          						.strength(2.5F)
          						.sound(SoundType.WOOD)
          						.setId(blockKey)));

          		ResourceKey<Item> itemKey = ResourceKey.create(Registries.ITEM, id("infinite_chest"));
          		Registry.register(BuiltInRegistries.ITEM, itemKey,
          				new BlockItem(INFINITE_CHEST, new Item.Properties().setId(itemKey).useBlockDescriptionPrefix()));

          		INFINITE_CHEST_BE = Registry.register(BuiltInRegistries.BLOCK_ENTITY_TYPE, id("infinite_chest"),
          				new BlockEntityType<>(InfiniteChestBlockEntity::new, Set.of(INFINITE_CHEST)));

          		INFINITE_CHEST_MENU = Registry.register(BuiltInRegistries.MENU, id("infinite_chest"),
          				new MenuType<>(InfiniteChestMenu::new, FeatureFlagSet.of()));
          	}
          }
