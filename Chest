          package com.example.infinitechest;

          import net.minecraft.client.gui.GuiGraphics;
          import net.minecraft.client.gui.components.Button;
          import net.minecraft.client.gui.screens.inventory.AbstractContainerScreen;
          import net.minecraft.client.renderer.RenderPipelines;
          import net.minecraft.network.chat.Component;
          import net.minecraft.resources.Identifier;
          import net.minecraft.world.entity.player.Inventory;

          public class InfiniteChestScreen extends AbstractContainerScreen<InfiniteChestMenu> {
          	private static final Identifier TEXTURE = Identifier.withDefaultNamespace("textures/gui/container/generic_54.png");

          	public InfiniteChestScreen(InfiniteChestMenu menu, Inventory inventory, Component title) {
          		super(menu, inventory, title);
          		this.imageHeight = 114 + 6 * 18;
          		this.inventoryLabelY = this.imageHeight - 94;
          	}

          	@Override
          	protected void init() {
          		super.init();
          		String[] labels = { "<<", "<", ">", ">>" };
          		int[] ids = { 2, 0, 1, 3 };
          		for (int i = 0; i < 4; i++) {
          			final int buttonId = ids[i];
          			addRenderableWidget(Button.builder(Component.literal(labels[i]), b -> press(buttonId))
          					.bounds(this.leftPos + 100 + i * 17, this.topPos + 3, 16, 12)
          					.build());
          		}
          	}

          	private void press(int buttonId) {
          		if (this.minecraft != null && this.minecraft.gameMode != null) {
          			this.minecraft.gameMode.handleInventoryButtonClick(this.menu.containerId, buttonId);
          		}
          	}

          	@Override
          	public void render(GuiGraphics graphics, int mouseX, int mouseY, float partialTick) {
          		super.render(graphics, mouseX, mouseY, partialTick);
          		this.renderTooltip(graphics, mouseX, mouseY);
          	}

          	@Override
          	protected void renderBg(GuiGraphics graphics, float partialTick, int mouseX, int mouseY) {
          		graphics.blit(RenderPipelines.GUI_TEXTURED, TEXTURE, this.leftPos, this.topPos,
          				0.0F, 0.0F, this.imageWidth, 6 * 18 + 17, 256, 256);
          		graphics.blit(RenderPipelines.GUI_TEXTURED, TEXTURE, this.leftPos, this.topPos + 6 * 18 + 17,
          				0.0F, 126.0F, this.imageWidth, 96, 256, 256);
          	}

          	@Override
          	protected void renderLabels(GuiGraphics graphics, int mouseX, int mouseY) {
          		super.renderLabels(graphics, mouseX, mouseY);
          		Component text = Component.literal("Page " + (this.menu.getPage() + 1));
          		int x = this.imageWidth - 8 - this.font.width(text);
          		graphics.drawString(this.font, text, x, this.inventoryLabelY, 0xFF404040, false);
          	}
          }
