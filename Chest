          package com.example.infinitechest;

          import java.util.ArrayList;
          import java.util.HashMap;
          import java.util.List;
          import java.util.Map;

          import com.mojang.serialization.Codec;
          import com.mojang.serialization.codecs.RecordCodecBuilder;

          import org.jspecify.annotations.Nullable;

          import net.minecraft.core.BlockPos;
          import net.minecraft.core.component.DataComponentGetter;
          import net.minecraft.core.component.DataComponentMap;
          import net.minecraft.network.chat.Component;
          import net.minecraft.world.MenuProvider;
          import net.minecraft.world.entity.player.Inventory;
          import net.minecraft.world.entity.player.Player;
          import net.minecraft.world.inventory.AbstractContainerMenu;
          import net.minecraft.world.item.ItemStack;
          import net.minecraft.world.level.block.entity.BlockEntity;
          import net.minecraft.world.level.block.state.BlockState;
          import net.minecraft.world.level.storage.ValueInput;
          import net.minecraft.world.level.storage.ValueOutput;

          /**
           * Sparse storage: only slots that actually hold something exist in the map,
           * so the chest can have "infinite" slots at no cost until you fill them.
           * Slot index = page * 54 + slotOnPage.
           */
          public class InfiniteChestBlockEntity extends BlockEntity implements MenuProvider {
          	public static final int PAGE_SIZE = 54;

          	public record Entry(long index, ItemStack stack) {
          		public static final Codec<Entry> CODEC = RecordCodecBuilder.create(i -> i.group(
          				Codec.LONG.fieldOf("index").forGetter(Entry::index),
          				ItemStack.CODEC.fieldOf("stack").forGetter(Entry::stack)).apply(i, Entry::new));
          		public static final Codec<List<Entry>> LIST_CODEC = CODEC.listOf();
          	}

          	private final Map<Long, ItemStack> items = new HashMap<>();

          	public InfiniteChestBlockEntity(BlockPos pos, BlockState state) {
          		super(InfiniteChestMod.INFINITE_CHEST_BE, pos, state);
          	}

          	public ItemStack get(long index) {
          		return items.getOrDefault(index, ItemStack.EMPTY);
          	}

          	public void put(long index, ItemStack stack) {
          		if (stack.isEmpty()) {
          			items.remove(index);
          		} else {
          			items.put(index, stack);
          		}
          		setChanged();
          	}

          	public void purgeEmpty() {
          		items.values().removeIf(ItemStack::isEmpty);
          	}

          	private List<Entry> toEntries() {
          		purgeEmpty();
          		List<Entry> list = new ArrayList<>(items.size());
          		items.forEach((index, stack) -> list.add(new Entry(index, stack)));
          		return list;
          	}

          	private void fromEntries(List<Entry> list) {
          		items.clear();
          		for (Entry e : list) {
          			if (!e.stack().isEmpty()) {
          				items.put(e.index(), e.stack());
          			}
          		}
          	}

          	@Override
          	protected void saveAdditional(ValueOutput output) {
          		super.saveAdditional(output);
          		List<Entry> entries = toEntries();
          		if (!entries.isEmpty()) {
          			output.store("Items", Entry.LIST_CODEC, entries);
          		}
          	}

          	@Override
          	protected void loadAdditional(ValueInput input) {
          		super.loadAdditional(input);
          		items.clear();
          		input.read("Items", Entry.LIST_CODEC).ifPresent(this::fromEntries);
          	}

          	// Lets the contents ride along on the dropped item (like a shulker box).
          	@Override
          	protected void collectImplicitComponents(DataComponentMap.Builder builder) {
          		super.collectImplicitComponents(builder);
          		List<Entry> entries = toEntries();
          		if (!entries.isEmpty()) {
          			builder.set(InfiniteChestMod.CONTENTS, entries);
          		}
          	}

          	@Override
          	protected void applyImplicitComponents(DataComponentGetter components) {
          		super.applyImplicitComponents(components);
          		List<Entry> entries = components.get(InfiniteChestMod.CONTENTS);
          		if (entries != null) {
          			fromEntries(entries);
          		}
          	}

          	@Override
          	public Component getDisplayName() {
          		return Component.translatable("block.infinitechest.infinite_chest");
          	}

          	@Override
          	public @Nullable AbstractContainerMenu createMenu(int containerId, Inventory inventory, Player player) {
          		return new InfiniteChestMenu(containerId, inventory, new PagedView(this));
          	}
          }
