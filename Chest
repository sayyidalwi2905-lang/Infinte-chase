          package com.example.infinitechest;

          import org.jspecify.annotations.Nullable;

          import net.minecraft.world.Container;
          import net.minecraft.world.SimpleContainer;
          import net.minecraft.world.entity.player.Inventory;
          import net.minecraft.world.entity.player.Player;
          import net.minecraft.world.inventory.AbstractContainerMenu;
          import net.minecraft.world.inventory.DataSlot;
          import net.minecraft.world.inventory.Slot;
          import net.minecraft.world.item.ItemStack;

          public class InfiniteChestMenu extends AbstractContainerMenu {
          	private static final int SIZE = InfiniteChestBlockEntity.PAGE_SIZE; // 6 rows x 9
          	private static final int MAX_PAGE = (1 << 30) - 1;

          	private final Container container;
          	private final @Nullable PagedView view; // server only

          	// The page number is split over two synced values because menu data is sent as 16-bit shorts.
          	private final DataSlot pageLow = DataSlot.standalone();
          	private final DataSlot pageHigh = DataSlot.standalone();

          	/** Client constructor. */
          	public InfiniteChestMenu(int containerId, Inventory inventory) {
          		this(containerId, inventory, new SimpleContainer(SIZE), null);
          	}

          	/** Server constructor. */
          	public InfiniteChestMenu(int containerId, Inventory inventory, PagedView view) {
          		this(containerId, inventory, view, view);
          	}

          	private InfiniteChestMenu(int containerId, Inventory inventory, Container container, @Nullable PagedView view) {
          		super(InfiniteChestMod.INFINITE_CHEST_MENU, containerId);
          		checkContainerSize(container, SIZE);
          		this.container = container;
          		this.view = view;
          		addDataSlot(pageLow);
          		addDataSlot(pageHigh);

          		for (int row = 0; row < 6; row++) {
          			for (int col = 0; col < 9; col++) {
          				addSlot(new Slot(container, col + row * 9, 8 + col * 18, 18 + row * 18));
          			}
          		}
          		for (int row = 0; row < 3; row++) {
          			for (int col = 0; col < 9; col++) {
          				addSlot(new Slot(inventory, col + row * 9 + 9, 8 + col * 18, 138 + row * 18));
          			}
          		}
          		for (int col = 0; col < 9; col++) {
          			addSlot(new Slot(inventory, col, 8 + col * 18, 196));
          		}
          	}

          	public int getPage() {
          		return (pageHigh.get() << 15) | pageLow.get();
          	}

          	private void setPage(int page) {
          		page = Math.max(0, Math.min(MAX_PAGE, page));
          		if (view != null) {
          			view.setPage(page);
          		}
          		pageLow.set(page & 0x7FFF);
          		pageHigh.set(page >> 15);
          	}

          	/** Button ids: 0 = -1 page, 1 = +1 page, 2 = -10 pages, 3 = +10 pages. */
          	@Override
          	public boolean clickMenuButton(Player player, int id) {
          		if (view == null) {
          			return false;
          		}
          		int delta = switch (id) {
          			case 0 -> -1;
          			case 1 -> 1;
          			case 2 -> -10;
          			case 3 -> 10;
          			default -> 0;
          		};
          		if (delta == 0) {
          			return false;
          		}
          		setPage(view.getPage() + delta);
          		return true;
          	}

          	@Override
          	public ItemStack quickMoveStack(Player player, int index) {
          		ItemStack result = ItemStack.EMPTY;
          		Slot slot = this.slots.get(index);
          		if (slot.hasItem()) {
          			ItemStack stack = slot.getItem();
          			result = stack.copy();
          			if (index < SIZE) {
          				if (!moveItemStackTo(stack, SIZE, this.slots.size(), true)) {
          					return ItemStack.EMPTY;
          				}
          			} else if (!moveItemStackTo(stack, 0, SIZE, false)) {
          				return ItemStack.EMPTY;
          			}
          			if (stack.isEmpty()) {
          				slot.setByPlayer(ItemStack.EMPTY);
          			} else {
          				slot.setChanged();
          			}
          		}
          		return result;
          	}

          	@Override
          	public void removed(Player player) {
          		super.removed(player);
          		if (view != null) {
          			view.purge();
          		}
          	}

          	@Override
          	public boolean stillValid(Player player) {
          		return container.stillValid(player);
          	}
          }
